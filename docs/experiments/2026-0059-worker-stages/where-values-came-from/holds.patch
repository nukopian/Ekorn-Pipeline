 subtest 'feeds and tees, unchanged' => sub {
--- /dev/null
+++ b/t/35-where-values-came-from.t
@@ -0,0 +1,261 @@
+use v5.36;
+use Test2::V0;
+use Test2::Plugin::NoWarnings;
+
+# A prototype (roadmap 2026-0060): a stage that holds values back says
+# so, with a holds part; it keeps an origin, kept_origin, for each value
+# it keeps, and gives what it made from that value marked by the
+# origin's gives; what it gives unmarked was made from many. So the
+# stages after it see each value's own original, in a flush too.
+
+use Ekorn::Pipeline;
+use Ekorn::Pipeline::Tooling qw(:core :flow :batch :sources :sinks :context source tee);
+use Ekorn::Pipeline::Context qw(kept_origin);
+
+my $class = 'Ekorn::Pipeline';
+
+# Rows from a source with an original part, counting how often it's
+# asked: each value is a row's name, and its original the row.
+sub rows ($n, $asked = undef) {
+    return source {
+        my $i = 0;
+        return {
+            step     => sub { $i < $n ? 'v' . ++$i : () },
+            original => sub { $$asked++ if $asked; "row $i" },
+        };
+    };
+}
+
+
+# What a stage sees: its value, and the original it's given.
+my $seen = sub { "$_ <- " . (result_original() // '-') };
+
+# A stage holding each value back by one, giving the one before; its
+# flush gives the last.
+sub one_behind () {
+    return gather {
+        my @held;    # [value, origin]
+        my $give = sub ($held) { $held->[1]->gives($held->[0]) };
+        return {
+            step => sub {
+                push @held, [$_[0], kept_origin];
+                return @held > 1 ? $give->(shift @held) : ();
+            },
+            flush => sub () { map { $give->($_) } splice @held },
+            holds => 1,
+        };
+    };
+}
+
+
+# A stage holding values until it has $n, then giving them all at once,
+# in reverse: several values from one call, each from its own.
+sub reversed_in ($n) {
+    return gather {
+        my @held;
+        my $give = sub () { map { $_->[1]->gives($_->[0]) } reverse splice @held };
+        return {
+            step  => sub { push @held, [$_[0], kept_origin]; @held >= $n ? $give->() : () },
+            flush => $give,
+            holds => 1,
+        };
+    };
+}
+
+subtest 'the stages after it get each value\'s own original, the flush\'s too' => sub {
+    is [$class->new(one_behind(), $seen)->iterator(rows(3))->all],
+        ['v1 <- row 1', 'v2 <- row 2', 'v3 <- row 3'], 'one behind';
+    is [$class->new(reversed_in(2), $seen)->iterator(rows(5))->all],
+        ['v2 <- row 2', 'v1 <- row 1', 'v4 <- row 4', 'v3 <- row 3', 'v5 <- row 5'],
+        'several at once, each its own';
+};
+
+subtest 'the stage itself, and those before it, see as now' => sub {
+    my(@before, @inside);
+    my $before = sub { push @before, result_original(); $_ };
+    my $inside = gather {
+        { step => sub { push @inside, result_original(); kept_origin->gives($_[0]) }, holds => 1 }
+    };
+    $class->new($before, $inside)->iterator(rows(2))->all;
+    is \@before, ['row 1', 'row 2'], 'before it';
+    is \@inside, ['row 1', 'row 2'], 'in it';
+};
+
+subtest 'through stages after it: maps, splits, and a stage that flushes' => sub {
+    my $split = sub { ("$_.a", "$_.b") };
+    is [$class->new(one_behind(), $split, $seen)->iterator(rows(2))->all],
+        ['v1.a <- row 1', 'v1.b <- row 1', 'v2.a <- row 2', 'v2.b <- row 2'], 'split';
+    my $total = gather { my $n = 0; (sub { $n++; $_[0] }, sub () {"total $n"}) };
+    is [$class->new(one_behind(), $total, $seen)->iterator(rows(2))->all],
+        ['v1 <- row 1', 'v2 <- row 2', 'total 2 <- -'],
+        'a flush of a stage that doesn\'t hold values back: none, as now';
+};
+
+subtest 'the source\'s part is asked only when a value is kept, as it\'s kept' => sub {
+    my $asked = 0;
+    $class->new(sub {$_}, sub {$_})->iterator(rows(5, \$asked))->all;
+    is $asked, 0, 'never, through maps';
+    $asked = 0;
+    $class->new(sub {$_}, one_behind(), sub {$_})->iterator(rows(5, \$asked))->all;
+    is $asked, 5, 'once a value it keeps';
+    $asked = 0;
+    $class->new(one_behind(), $seen, $seen)->iterator(rows(5, \$asked))->all;
+    is $asked, 5, 'and not again when the stages after it ask';
+    $asked = 0;
+    $class->new(batch(2), $seen)->iterator(rows(5, \$asked))->all;
+    is $asked, 0, 'never, by a stage that keeps no origin: batch';
+};
+
+subtest 'with no source, the value passed in' => sub {
+    is [$class->new(sub { $_ * 10 }, one_behind(), $seen)->(1 .. 3)],
+        ['10 <- 1', '20 <- 2', '30 <- 3'], 'pushed';
+    my $feed = $class->new(one_behind(), $seen)->feed;
+    my @got  = map { $feed->push($_) } qw(a b c);
+    push @got, $feed->close;
+    is \@got, ['a <- a', 'b <- b', 'c <- c'], 'fed';
+};
+
+subtest 'what its stop carries, marked, keeps where it came from' => sub {
+    my $stops = gather {
+        {
+            step => sub {
+                my $origin = kept_origin;
+                $_[0] eq 'v2' ? Stop($origin->gives("$_[0]!")) : $origin->gives($_[0]);
+            },
+            holds => 1,
+        }
+    };
+    is [$class->new($stops, $seen)->iterator(rows(4))->all], ['v1 <- row 1', 'v2! <- row 2'],
+        'the stop\'s value, from the value that stopped';
+    my $held_stop = gather {
+        my @held;
+        {
+            step => sub {
+                push @held, [$_[0], kept_origin];
+                return if @held < 3;
+                Stop(map { $_->[1]->gives($_->[0]) } splice @held);
+            },
+            holds => 1,
+        }
+    };
+    is [$class->new($held_stop, $seen)->iterator(rows(5))->all],
+        ['v1 <- row 1', 'v2 <- row 2', 'v3 <- row 3'], 'a stop carrying values it held';
+};
+
+subtest 'a value given unmarked was made from many: none' => sub {
+    my $pairs = gather {
+        my @held;
+        { step => sub { push @held, $_[0]; @held == 2 ? [splice @held] : () }, holds => 1 }
+    };
+    is [$class->new($pairs, sub { join ',', @{ $_[0] } }, $seen)->iterator(rows(4))->all],
+        ['v1,v2 <- -', 'v3,v4 <- -'], 'undef';
+};
+
+subtest 'Ekorn\'s own: take_last, batch, collect' => sub {
+    is [$class->new(take_last, $seen)->iterator(rows(3))->all], ['v3 <- row 3'],
+        'take_last: the last value\'s (it had none)';
+    is [$class->new(batch(2), sub { join ',', @{ $_[0] } }, $seen)->iterator(rows(3))->all],
+        ['v1,v2 <- -', 'v3 <- -'], 'batch: none (a batch filled by a value had its)';
+    is [$class->new(collect, sub { join ',', @{ $_[0] } }, $seen)->iterator(rows(3))->all],
+        ['v1,v2,v3 <- -'], 'collect: none, as now';
+    is [$class->new(take_last)->(undef)], [undef], 'take_last of undef';
+};
+
+subtest 'an iterator read as a source passes on the original of the value it handed out' => sub {
+    my $inner = $class->new(one_behind());
+    is [$class->new($seen)->iterator($inner->iterator(rows(3)))->all],
+        ['v1 <- row 1', 'v2 <- row 2', 'v3 <- row 3'], 'through one';
+    my $plain = $class->new(sub {$_});
+    is [$class->new($seen)->iterator($plain->iterator(rows(2)))->all], ['v1 <- row 1', 'v2 <- row 2'],
+        'with no stage that holds values back, as now';
+};
+
+subtest 'kept_origin only in a stage that holds values back' => sub {
+    like dies { $class->new(sub { kept_origin; $_ })->(1) },
+        qr( Expected\ kept_origin\ in\ the\ step\ of\ a\ stage\ that\ holds\ values\ back )x,
+        'a map';
+    like dies { kept_origin() }, qr( Expected\ kept_origin )x, 'outside a run';
+    my $nests = gather {
+        { step => sub { $class->new(sub { kept_origin; $_ })->($_[0]) }, holds => 1 }
+    };
+    like dies { $class->new($nests)->(1) }, qr( Expected\ kept_origin )x,
+        'a map in a run inside its step';
+};
+
+subtest 'by name only; a list keeps its three parts; not beside a pipeline' => sub {
+    my $listed = gather { (sub { $_[0] }, undef, undef) };
+    is [$class->new($listed, $seen)->(1)], ['1 <- 1'], 'a list: a map, as now';
+    my $object = bless {}, 'Local::Holds';
+    no strict 'refs';    ## no critic (TestingAndDebugging::ProhibitNoStrict)
+    *{'Local::Holds::EKORN_STAGE'} = sub ($self) {
+        { step => sub { kept_origin->gives($_[0]) }, holds => 1 };
+    };
+    is [$class->new($object, $seen)->(7)], ['7 <- 7'], 'from a class\'s EKORN_STAGE';
+    like dies { $class->new(gather { {step => $class->new(sub {$_}), holds => 1} })->(1) },
+        qr( \AExpected\ stage\ \#1,\ made\ with\ gather,\ to\ hold\ values\ back\ in\ its\ step,\ not\ in\ a\ pipeline )x,
+        'beside a pipeline, it croaks';
+    like dies { $class->new(gather { (sub {$_}, undef, undef, undef) })->(1) },
+        qr( \AExpected\ stage\ \#1,\ made\ with\ gather,\ to\ return\ a\ code\ reference\ or\ a\ pipeline,\ and\ optionally\ a\ flush\ and\ an\ end )x,
+        'the gather message, word for word';
+};
+
+subtest 'a run ended from outside, mid-step, leaves nothing for another' => sub {
+    my $inner_it;
+    my $ends_inner = gather {
+        {
+            step => sub {
+                $inner_it->finish;
+                my $origin = kept_origin;
+                ($origin->gives("$_[0]-a"), $origin->gives("$_[0]-b"));
+            },
+            holds => 1,
+        }
+    };
+    my $s = sub ($x) {
+        $inner_it = $class->new($ends_inner)->iterator(from_array('in'));
+        $inner_it->next;
+        ("$x.a", "$x.b");
+    };
+    is [$class->new(take_last, $s, $seen)->iterator(rows(2))->all], ['v2.a <- row 2', 'v2.b <- row 2'],
+        'the outer run\'s values keep their own';
+};
+
+subtest 'nested in itself, inside its own step' => sub {
+    my $nesting = gather {
+        {
+            step => sub {
+                my $origin = kept_origin;
+                my @inner  = $class->new(one_behind(), $seen)->iterator(rows(2))->all;
+                $origin->gives([@inner, $seen->()]);
+            },
+            holds => 1,
+        }
+    };
+    is [$class->new($nesting, $seen)->iterator(rows(2))->all],
+        [
+            match(qr( \AARRAY )x), match(qr( \AARRAY )x),
+        ],
+        'runs';
+    my @got = $class->new($nesting)->iterator(rows(2))->all;
+    is \@got,
+        [['v1 <- row 1', 'v2 <- row 2', 'v1 <- row 1'], ['v1 <- row 1', 'v2 <- row 2', 'v2 <- row 2']],
+        'a run inside its step answers for itself, and leaves its own run\'s';
+};
+
+subtest 'the guard is the run\'s: a run with no stage that holds values back croaks, after a stop too' => sub {
+    my $stops = gather { { step => sub { Stop(kept_origin->gives("$_[0]!")) }, holds => 1 } };
+    my $tries = sub {
+        my $inner = $class->new(sub { kept_origin; $_ });
+        (eval { $inner->($_); 1 } ? 'kept' : 'croaked') . " $_";
+    };
+    is [$class->new($stops, $tries)->(1, 2)], ['croaked 1!'], 'a run nested in a stage after it';
+};
+
+subtest 'in a flush, an origin of nothing, as a flush has no value' => sub {
+    my $in_flush = gather {
+        { step => sub {return}, flush => sub () { kept_origin->gives('x') }, holds => 1 }
+    };
+    is [$class->new($in_flush, $seen)->(1)], ['x <- -'], 'marked, with none';
+};
+
+done_testing;
