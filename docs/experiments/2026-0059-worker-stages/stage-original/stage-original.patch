+# Return $step and $flush of a stage with an original part, each made to
+# set the part answering for the values it gives, as it returns them or
+# a stop carries them, in the run's @result. So the run loop needn't ask,
+# for each value, whether a stage has a part: only a stage that has one
+# pays, a call a value.
+sub _answering ($original, $step, $flush) {
+    my $answer = sub ($code) {
+        return undef unless $code;    ## no critic (Subroutines::ProhibitExplicitReturnUndef)
+        # For each value: no signature.
+        return sub {
+            my @values;
+            try {
+                @values = $code->(@_);
+            }
+            catch ($e) {
+                $Ekorn::Pipeline::CURRENT_RESULT->[2] = $original if $e isa 'Ekorn::Pipeline::Stop';
+                die $e;    ## no critic (ErrorHandling::RequireCarping): thrown again, as it was
+            }
+            $Ekorn::Pipeline::CURRENT_RESULT->[2] = $original;
+            return @values;
+        };
+    };
+    return ($answer->($step), $answer->($flush));
+}
